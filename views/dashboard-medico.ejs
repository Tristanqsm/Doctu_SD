<%- include('partials/header') %>

  <% const tituloMedico = user.nombre.startsWith('Dr') ? user.nombre : 'Dr. ' + user.nombre; %>

  <div class="page-header">
    <div>
      <h2 class="page-title"><%= tituloMedico %></h2>
      <div class="page-meta">
        <span><%= user.especialidad || 'Medicina General' %></span>
        <span>·</span>
        <span class="mono">Cédula <%= user.cedula || 'En trámite' %></span>
      </div>
    </div>
    <span class="mono">Fecha: <%= hoy %></span>
  </div>

  <!-- Métricas rápidas -->
  <div class="grid-3">
    <div class="stat-card">
      <div class="stat-icon" style="background: var(--primary-soft); color: var(--primary);">🗓️</div>
      <div class="stat-info">
        <div class="stat-num"><%= totalCitasHoy %></div>
        <div class="stat-label">Citas para Hoy</div>
      </div>
    </div>

    <div class="stat-card">
      <div class="stat-icon" style="background: var(--warning-soft); color: var(--warning);">⏳</div>
      <div class="stat-info">
        <div class="stat-num"><%= citasPendientes %></div>
        <div class="stat-label">Por Atender</div>
      </div>
    </div>

    <div class="stat-card">
      <div class="stat-icon" style="background: var(--success-soft); color: var(--success);">📋</div>
      <div class="stat-info">
        <div class="stat-num"><%= totalExpedientes %></div>
        <div class="stat-label">Expedientes</div>
      </div>
    </div>
  </div>

  <!-- Agenda de Citas -->
  <div class="card">
    <div class="card-header">
      <div class="card-title">Agenda de Consultas</div>
      <a href="/citas/nueva" class="btn btn-sm btn-outline">＋ Agendar Cita</a>
    </div>

    <% if (citas.length === 0) { %>
      <p style="color: var(--text-muted); text-align: center; padding: 1.25rem;">No tienes citas programadas por el momento.</p>
    <% } else { %>
      <div class="table-responsive">
        <table class="table">
          <thead>
            <tr>
              <th>Fecha / Hora</th>
              <th>Paciente</th>
              <th>CURP / Contacto</th>
              <th>Motivo de Consulta</th>
              <th>Estado</th>
              <th style="text-align: right;">Acciones</th>
            </tr>
          </thead>
          <tbody>
            <% citas.forEach(c => { %>
              <tr class="<%= c.fecha === hoy ? 'cita-hoy' : '' %>">
                <td style="white-space: nowrap;">
                  <strong style="color: var(--ink);"><%= c.fecha %></strong><br>
                  <span class="mono" style="font-size: 0.72rem;"><%= c.hora %> hrs</span>
                </td>
                <td>
                  <strong style="color: var(--ink);"><%= c.paciente_nombre %></strong>
                </td>
                <td style="white-space: nowrap;">
                  <code><%= c.paciente_curp || 'Sin CURP' %></code><br>
                  <span style="font-size: 0.76rem; color: var(--text-muted);"><%= c.paciente_telefono || 'Sin Tel' %></span>
                </td>
                <td><%= c.motivo %></td>
                <td>
                  <span class="badge badge-<%= c.estado.toLowerCase() %>"><%= c.estado %></span>
                </td>
                <td style="text-align: right; white-space: nowrap;">
                  <div class="btn-group">
                    <% if (c.estado === 'Pendiente' || c.estado === 'Confirmada') { %>
                      <a href="/expedientes/nuevo?citaId=<%= c.id %>&pacienteId=<%= c.paciente_id %>" class="btn btn-sm btn-primary">
                        Atender
                      </a>
                    <% } %>

                    <% if (c.estado === 'Pendiente') { %>
                      <form action="/citas/<%= c.id %>/estado" method="POST" style="display:inline;">
                        <input type="hidden" name="estado" value="Confirmada">
                        <button type="submit" class="btn btn-sm btn-outline">Confirmar</button>
                      </form>
                    <% } %>

                    <% if (c.estado !== 'Cancelada' && c.estado !== 'Atendida') { %>
                      <form action="/citas/<%= c.id %>/estado" method="POST" style="display:inline;" onsubmit="return confirm('¿Cancelar esta cita?');">
                        <input type="hidden" name="estado" value="Cancelada">
                        <button type="submit" class="btn btn-sm btn-ghost-danger" title="Cancelar cita">✕</button>
                      </form>
                    <% } %>
                  </div>
                </td>
              </tr>
            <% }); %>
          </tbody>
        </table>
      </div>
    <% } %>
  </div>

  <!-- Directorio de Pacientes -->
  <div class="card" style="margin-bottom: 0;">
    <div class="card-header">
      <div class="card-title">Directorio de Pacientes</div>
      <form action="/dashboard-medico" method="GET" style="display: flex; gap: 0.45rem; align-items: center;">
        <input type="text" name="q" value="<%= busqueda %>" class="form-control" placeholder="Buscar paciente o CURP..." style="width: 240px; padding: 0.38rem 0.85rem; font-size: 0.82rem;">
        <button type="submit" class="btn btn-sm btn-outline">Buscar</button>
        <% if (busqueda) { %>
          <a href="/dashboard-medico" class="btn btn-sm btn-ghost-danger" title="Limpiar búsqueda">✕</a>
        <% } %>
      </form>
    </div>

    <% if (pacientes.length === 0) { %>
      <p style="color: var(--text-muted); text-align: center; padding: 1rem;">No se encontraron pacientes que coincidan con la búsqueda.</p>
    <% } else { %>
      <div class="table-responsive">
        <table class="table">
          <thead>
            <tr>
              <th>Paciente</th>
              <th>CURP</th>
              <th>Correo</th>
              <th>Teléfono</th>
              <th style="text-align: right;">Expediente</th>
            </tr>
          </thead>
          <tbody>
            <% pacientes.forEach(p => { %>
              <tr>
                <td><strong style="color: var(--ink);"><%= p.nombre_completo %></strong></td>
                <td><code><%= p.curp || 'No registrado' %></code></td>
                <td><%= p.email %></td>
                <td class="mono"><%= p.telefono || 'Sin teléfono' %></td>
                <td style="text-align: right; white-space: nowrap;">
                  <div class="btn-group">
                    <a href="/expedientes/paciente/<%= p.id %>" class="btn btn-sm btn-outline">Ver Historial</a>
                    <a href="/expedientes/nuevo?pacienteId=<%= p.id %>" class="btn btn-sm btn-primary">＋ Consulta</a>
                  </div>
                </td>
              </tr>
            <% }); %>
          </tbody>
        </table>
      </div>
    <% } %>
  </div>

<%- include('partials/footer') %>