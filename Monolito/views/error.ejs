<%- include('partials/header') %>

<div class="container-narrow" style="text-align: center; margin: 3rem auto;">
  <div class="card" style="padding: 2.5rem 1.5rem;">
    <h1 style="color: var(--danger); font-size: 2.5rem; margin-bottom: 0.5rem;">⚠️</h1>
    <h2 style="color: var(--primary); margin-bottom: 0.5rem;"><%= title || 'Ocurrió un Error' %></h2>
    <p style="color: var(--text-muted); margin-bottom: 1.5rem;">
      <%= typeof mensaje !== 'undefined' ? mensaje : 'No pudimos procesar tu solicitud.' %>
    </p>

    <div style="display: flex; gap: 1rem; justify-content: center;">
      <a href="/" class="btn btn-primary">Ir al Inicio</a>
      <% if (typeof user !== 'undefined' && user) { %>
        <a href="<%= user.rol === 'medico' ? '/dashboard-medico' : '/portal-paciente' %>" class="btn btn-outline">
          Volver a Mi Panel
        </a>
      <% } %>
    </div>
  </div>
</div>

<%- include('partials/footer') %>

