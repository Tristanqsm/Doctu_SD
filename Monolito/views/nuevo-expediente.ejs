<%- include('partials/header') %>

<div style="max-width: 800px; margin: 1rem auto;">
  <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1rem;">
    <h2 style="color: var(--primary);">Registrar Expediente Clínico</h2>
    <a href="/dashboard-medico" class="btn btn-outline btn-sm">← Volver al Panel</a>
  </div>

  <div class="card">
    <form action="/expedientes/nuevo" method="POST">
      <% if (citaSeleccionada) { %>
        <input type="hidden" name="id_cita" value="<%= citaSeleccionada.id %>">
      <% } %>

      <!-- Paciente y Fecha -->
      <div class="form-row">
        <div class="form-group" style="flex: 2;">
          <label for="id_paciente" class="form-label">Paciente:</label>
          <% if (pacienteSeleccionado) { %>
            <input type="hidden" name="id_paciente" value="<%= pacienteSeleccionado.id %>">
            <input type="text" class="form-control" value="<%= pacienteSeleccionado.nombre_completo %> (CURP: <%= pacienteSeleccionado.curp || 'N/A' %>)" readonly style="background-color: #edf2f7;">
          <% } else { %>
            <select name="id_paciente" id="id_paciente" class="form-control" required>
              <option value="">-- Selecciona un paciente --</option>
              <% pacientes.forEach(p => { %>
                <option value="<%= p.id %>">
                  <%= p.nombre_completo %> <%= p.curp ? '(' + p.curp + ')' : '' %>
                </option>
              <% }); %>
            </select>
          <% } %>
        </div>

        <div class="form-group" style="flex: 1;">
          <label for="fecha" class="form-label">Fecha de Consulta:</label>
          <input type="date" id="fecha" name="fecha" class="form-control" value="<%= hoy %>" required>
        </div>
      </div>

      <!-- Signos Vitales (Somatometría Básica) -->
      <div style="background: #f7fafc; border: 1px solid var(--border-color); border-radius: var(--radius); padding: 1rem; margin-bottom: 1.25rem;">
        <label class="form-label" style="color: var(--primary); margin-bottom: 0.75rem;">🩺 Signos Vitales y Somatometría</label>
        <div class="form-row">
          <div class="form-group">
            <label for="presion_arterial" class="form-label" style="font-weight: normal; font-size: 0.82rem;">Presión Arterial (mmHg):</label>
            <input type="text" id="presion_arterial" name="presion_arterial" class="form-control" placeholder="Ej. 120/80">
          </div>
          <div class="form-group">
            <label for="temperatura_c" class="form-label" style="font-weight: normal; font-size: 0.82rem;">Temperatura (°C):</label>
            <input type="number" step="0.1" id="temperatura_c" name="temperatura_c" class="form-control" placeholder="Ej. 36.5">
          </div>
          <div class="form-group">
            <label for="peso_kg" class="form-label" style="font-weight: normal; font-size: 0.82rem;">Peso (kg):</label>
            <input type="number" step="0.1" id="peso_kg" name="peso_kg" class="form-control" placeholder="Ej. 70.5">
          </div>
          <div class="form-group">
            <label for="talla_cm" class="form-label" style="font-weight: normal; font-size: 0.82rem;">Talla (cm):</label>
            <input type="number" step="1" id="talla_cm" name="talla_cm" class="form-control" placeholder="Ej. 175">
          </div>
        </div>
      </div>

      <!-- Motivo de Consulta -->
      <div class="form-group">
        <label for="motivo_consulta" class="form-label">Motivo de Consulta y Síntomas:</label>
        <textarea id="motivo_consulta" name="motivo_consulta" class="form-control" rows="2" placeholder="Describa el motivo por el cual acude el paciente y síntomas referidos..." required><%= citaSeleccionada ? citaSeleccionada.motivo : '' %></textarea>
      </div>

      <!-- Diagnóstico -->
      <div class="form-group">
        <label for="diagnostico" class="form-label">Diagnóstico Clínico:</label>
        <input type="text" id="diagnostico" name="diagnostico" class="form-control" placeholder="Ej. Faringitis aguda / Gastritis / Cefalea tensional" required>
      </div>

      <!-- Plan de Tratamiento y Receta -->
      <div class="form-group">
        <label for="tratamiento_receta" class="form-label">Plan de Tratamiento y Receta Médica:</label>
        <textarea id="tratamiento_receta" name="tratamiento_receta" class="form-control" rows="4" placeholder="Medicamentos, dosis, frecuencia, duración y recomendaciones generales..." required></textarea>
      </div>

      <!-- Notas adicionales -->
      <div class="form-group">
        <label for="notas" class="form-label">Notas de Evolución u Observaciones Clínicas (opcional):</label>
        <textarea id="notas" name="notas" class="form-control" rows="2" placeholder="Notas internas, evolución esperada o fecha sugerida para próxima revisión..."></textarea>
      </div>

      <div style="display: flex; gap: 1rem; justify-content: flex-end; margin-top: 1.5rem;">
        <a href="/dashboard-medico" class="btn btn-outline">Cancelar</a>
        <button type="submit" class="btn btn-primary">
          💾 Guardar y Finalizar Expediente
        </button>
      </div>
    </form>
  </div>
</div>

<%- include('partials/footer') %>

